<section class="video-section">
	<div class="container">
		<h2 class="video-section__title text-h2">How I Find CRO Breakthroughs Again and Again</h2>

		<div class="video-section__embed">
			<iframe
				src="https://www.youtube.com/embed/STouQwJZ4bY"
				title="How I Find CRO Breakthroughs Again and Again"
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
				allowfullscreen
			/>
		</div>
	</div>
</section>

<style>
	.video-section {
		padding-block: var(--space-24);
	}

	@media (max-width: 768px) {
		.video-section {
			padding-block: var(--space-12);
		}
	}

	.video-section__title {
		margin: 0 0 var(--space-8);
	}

	.video-section__embed {
		position: relative;
		aspect-ratio: 16 / 9;
		border: 1px solid var(--color-accent);
	}

	.video-section__embed iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
