---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__top">
			<div class="site-footer__brand">
				<a class="site-footer__logo" href="/" aria-label="99Ways home">
					<Logo variant="compact" />
				</a>
			</div>

			<div class="site-footer__columns">
				{
					columns.map((col) => (
						<div class="site-footer__col">
							<h3 class="site-footer__heading text-label">{col.heading}</h3>
							<ul class="site-footer__list">
								{
									col.links.map((link) => (
										<li>
											<a
												href={link.href}
												class="site-footer__link"
												target={link.href.startsWith("http") ? "_blank" : null}
												rel={link.href.startsWith("http") ? "noopener noreferrer" : null}
											>
												{link.label}
											</a>
										</li>
									))
								}
							</ul>
						</div>
					))
				}
			</div>
		</div>

		<div class="site-footer__social" aria-label="Social links">
			{
				socials.map((social) => (
					<a
						class="site-footer__social-link"
						href={social.href}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={social.label}
						title={social.label}
					>
						<svg class="site-footer__social-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={social.path} /></svg>
					</a>
				))
			}
		</div>

		<div class="site-footer__map">
			<div class="site-footer__map-placeholder">
				<span class="text-label">map — pending treatment decision</span>
			</div>
		</div>

		<div class="site-footer__legal">
			<p class="site-footer__legal-text text-small">
				<em>Ninety Nine Ways</em>{" "}
				{legal}
			</p>

			<div class="site-footer__bottom">
				<span class="text-small">2025 99Ways | All right reserved.</span>
				<nav class="site-footer__legal-links" aria-label="Legal">
					<a href="/privacy-policy/">Privacy Policy</a>
					<a href="/terms-of-use/">Terms of Service</a>
				</nav>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		padding-block: var(--space-16) var(--space-8);
	}

	.site-footer__top {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
		gap: var(--space-12);
	}

	.site-footer__logo img {
		width: 64px;
		height: auto;
	}

	.site-footer__columns {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-8);
	}

	.site-footer__heading {
		margin: 0 0 var(--space-4);
		color: var(--color-text);
	}

	.site-footer__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.site-footer__link {
		color: var(--color-text-muted);
		font-family: var(--font-sans);
		font-size: 0.875rem;
		line-height: 1.4;
		text-decoration: none;
	}

	.site-footer__link:hover,
	.site-footer__link:active {
		color: var(--color-accent);
	}

	.site-footer__social {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-12);
	}

	.site-footer__social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--color-text-muted);
	}

	.site-footer__social-link:hover {
		color: var(--color-accent);
	}

	.site-footer__social-icon {
		width: 20px;
		height: 20px;
	}

	.site-footer__map {
		margin-top: var(--space-12);
	}

	.site-footer__map-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 200px;
		border: 1px dashed var(--color-border-strong);
		color: var(--color-text-muted);
	}

	.site-footer__legal {
		margin-top: var(--space-12);
	}

	.site-footer__legal-text {
		color: var(--color-text-muted);
		max-width: 80ch;
		margin: 0;
	}

	.site-footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		margin-top: var(--space-6);
		color: var(--color-text-muted);
	}

	.site-footer__legal-links {
		display: flex;
		gap: var(--space-4);
	}

	.site-footer__legal-links a {
		color: var(--color-text-muted);
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		text-decoration: none;
	}

	.site-footer__legal-links a:hover {
		color: var(--color-accent);
	}

	@media (max-width: 768px) {
		.site-footer__top {
			grid-template-columns: 1fr;
			gap: var(--space-8);
		}

		.site-footer__columns {
			grid-template-columns: 1fr;
			gap: var(--space-6);
		}

		.site-footer__bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
